{
  "name": "@robinchan/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agri perps contracts (AgriFeed, AgriVault, AgriPerp) — a standalone Hardhat project, kept out of the npm workspaces so the web app and worker never install the Solidity toolchain.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.ts",
    "abi": "hardhat compile && node scripts/export-abi.mjs",
    "wallet:check": "npx tsx scripts/wallet-check.ts",
    "launch:base": "hardhat run scripts/launch-network.ts --network base",
    "launch:arbitrum": "hardhat run scripts/launch-network.ts --network arbitrum",
    "list-agri:base": "hardhat run scripts/list-agri-markets.ts --network base",
    "list-agri:arbitrum": "hardhat run scripts/list-agri-markets.ts --network arbitrum",
    "wallet:check:hemat": "npx tsx scripts/wallet-check.ts --hemat",
    "launch:base:hemat": "hardhat run scripts/launch-budget.ts --network base",
    "add-agri:base": "hardhat run scripts/add-agri.ts --network base",
    "add-agri:arbitrum": "hardhat run scripts/add-agri.ts --network arbitrum"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@pythnetwork/pyth-sdk-solidity": "4.3.1",
    "@types/node": "^22.18.0",
    "hardhat": "3.18.0",
    "typescript": "^5.9.2",
    "viem": "^2.56.8"
  }
}
