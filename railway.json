{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/**",
      "/scripts/service-*.mjs",
      "/package.json",
      "/package-lock.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@robinchan/worker"
  }
}
